{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d67c37fe-3251-458c-aa5b-c6f255cbcbcb","database_name": "web-app-3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "11b72f24c6b543feabb17b4b3b9c038d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
